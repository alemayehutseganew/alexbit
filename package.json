{
  "name": "alexbit",
  "private": true,
  "packageManager": "npm@11.19.1",
  "scripts": {
    "postinstall": "npm run prisma:generate",
    "prisma:generate": "npm exec --workspace=@primehorizon/domain -- prisma generate --schema prisma/schema.prisma",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "turbo": "^2.11.13",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
