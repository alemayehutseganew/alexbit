{
  "name": "alexbit",
  "private": true,
  "packageManager": "npm@11.19.1",
  "scripts": {
    "postinstall": "prisma generate --schema=packages/domain/prisma/schema.prisma",
    "prisma:generate": "npm run generate --workspace=@primehorizon/domain",
    "prisma:migrate:deploy": "npm run migrate:deploy --workspace=@primehorizon/domain",
    "build": "npm run prisma:generate && npm run build --workspace=api",
    "start": "npm run start:prod --workspace=api",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "prisma": "^6.19.0",
    "turbo": "^2.11.13",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "@prisma/client": "^6.19.3"
  }
}
