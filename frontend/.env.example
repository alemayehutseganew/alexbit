NEXT_PUBLIC_API_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3001

# Generate a secret with: npx auth secret
AUTH_SECRET=

# Keycloak Client Realm
# Callback URL: http://localhost:3001/api/auth/callback/keycloak-client
# The Keycloak user profile must expose a trusted "tenantId" or "tenant_id" claim.
AUTH_KEYCLOAK_CLIENT_ID=
AUTH_KEYCLOAK_CLIENT_SECRET=
AUTH_KEYCLOAK_CLIENT_ISSUER=

# Legacy single-client aliases are supported when the AUTH_KEYCLOAK_CLIENT_* values are unset.
KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_ISSUER=

# Keycloak Shareholder Realm
# Callback URL: http://localhost:3001/api/auth/callback/keycloak-shareholder
AUTH_KEYCLOAK_SHAREHOLDER_ID=
AUTH_KEYCLOAK_SHAREHOLDER_SECRET=
AUTH_KEYCLOAK_SHAREHOLDER_ISSUER=
