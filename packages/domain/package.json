{
  "name": "@primehorizon/domain",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./prisma": {
      "types": "./dist/prisma.d.ts",
      "default": "./dist/prisma.js"
    },
    "./auth-schema": {
      "types": "./dist/schemas/auth.schema.d.ts",
      "default": "./dist/schemas/auth.schema.js"
    },
    "./rfp-schema": {
      "types": "./dist/schemas/rfp.schema.d.ts",
      "default": "./dist/schemas/rfp.schema.js"
    },
    "./rfp-status-schema": {
      "types": "./dist/schemas/rfp-status.schema.d.ts",
      "default": "./dist/schemas/rfp-status.schema.js"
    },
    "./contact-schema": {
      "types": "./dist/schemas/contact.schema.d.ts",
      "default": "./dist/schemas/contact.schema.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "generate": "prisma generate --schema prisma/schema.prisma",
    "migrate:deploy": "prisma migrate deploy --schema prisma/schema.prisma",
    "check-types": "tsc --noEmit"
  },
  "devDependencies": {
    "@repo/typescript-config": "*",
    "dotenv": "^16.6.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "bcrypt": "^6.0.0",
    "prisma": "^6.19.0",
    "zod": "^3.25.76"
  }
}
